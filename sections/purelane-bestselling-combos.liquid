<section
  id="combos-{{ section.id }}"
  class="purelane-combos"
>
  <div class="purelane-combos__container">

    <div class="purelane-combos__heading">
      <span class="purelane-combos__eyebrow">
        {{ section.settings.eyebrow }}
      </span>

      <h2>
        {{ section.settings.heading }}
      </h2>

      <p>
        {{ section.settings.description }}
      </p>
    </div>

    <div class="purelane-combos__rail">

      {% for block in section.blocks %}

        <article
          class="purelane-combo"
          {{ block.shopify_attributes }}
        >

          <div class="purelane-combo__top">

            {% if block.settings.badge != blank %}
              <span class="purelane-combo__badge">
                {{ block.settings.badge }}
              </span>
            {% endif %}

            {% if block.settings.save_text != blank %}
              <span class="purelane-combo__save">
                {{ block.settings.save_text }}
              </span>
            {% endif %}

            <div class="purelane-combo__products">

              {% for i in (1..3) %}

                {% case i %}

                  {% when 1 %}
                    {% assign product = block.settings.product_1 %}
                    {% assign label = block.settings.label_1 %}

                  {% when 2 %}
                    {% assign product = block.settings.product_2 %}
                    {% assign label = block.settings.label_2 %}

                  {% when 3 %}
                    {% assign product = block.settings.product_3 %}
                    {% assign label = block.settings.label_3 %}

                {% endcase %}

                {% if product != blank %}

                  <div class="purelane-combo__product">

                    <div class="purelane-combo__image">

                      {% if product.featured_image %}
                        {{
                          product.featured_image
                          | image_url: width: 400
                          | image_tag:
                            loading: 'lazy',
                            widths: '200,300,400',
                            alt: product.title
                        }}
                      {% endif %}

                    </div>

                    {% if label != blank %}
                      <span>
                        {{ label }}
                      </span>
                    {% else %}
                      <span>
                        {{ product.title }}
                      </span>
                    {% endif %}

                  </div>

                  {% unless forloop.last %}
                    <div class="purelane-combo__plus">
                      +
                    </div>
                  {% endunless %}

                {% endif %}

              {% endfor %}

            </div>

          </div>

          <div class="purelane-combo__content">

            <h3>
              {{ block.settings.title }}
            </h3>

            <span class="purelane-combo__count">
              {{ block.settings.count }}
            </span>

            <p>
              {{ block.settings.description }}
            </p>

            <div class="purelane-combo__price">

              <strong>
                {{ block.settings.price }}
              </strong>

              {% if block.settings.compare_price != blank %}
                <s>
                  {{ block.settings.compare_price }}
                </s>
              {% endif %}

              {% if block.settings.saving != blank %}
                <em>
                  {{ block.settings.saving }}
                </em>
              {% endif %}

            </div>

            <div class="purelane-combo__fine">
              Inclusive of all taxes · COD available
            </div>

            {% if block.settings.button_link != blank %}
              <a
                href="{{ block.settings.button_link }}"
                class="purelane-combo__button"
              >
                {{ block.settings.button_text }}
                <span>→</span>
              </a>
            {% endif %}

          </div>

        </article>

      {% endfor %}

    </div>

    <div class="purelane-combos__swipe">
      ← Swipe for more combos →
    </div>

  </div>
</section>


<style>

#combos-{{ section.id }} {
  padding: 110px 0;
  background: #f7f4ed;
  overflow: hidden;
}

#combos-{{ section.id }} .purelane-combos__container {
  width: min(1400px, calc(100% - 48px));
  margin: 0 auto;
}

#combos-{{ section.id }} .purelane-combos__heading {
  text-align: center;
  max-width: 760px;
  margin: 0 auto 55px;
}

#combos-{{ section.id }} .purelane-combos__eyebrow {
  display: block;
  margin-bottom: 14px;
  color: #5531d7;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .18em;
  text-transform: uppercase;
}

#combos-{{ section.id }} h2 {
  margin: 0;
  color: #111;
  font-size: clamp(38px, 5vw, 64px);
  line-height: .98;
  letter-spacing: -.045em;
}

#combos-{{ section.id }} .purelane-combos__heading p {
  max-width: 650px;
  margin: 22px auto 0;
  color: #69657a;
  font-size: 16px;
  line-height: 1.7;
}

#combos-{{ section.id }} .purelane-combos__rail {
  display: flex;
  gap: 22px;
  overflow-x: auto;
  padding: 10px 5px 30px;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
}

#combos-{{ section.id }} .purelane-combos__rail::-webkit-scrollbar {
  display: none;
}

#combos-{{ section.id }} .purelane-combo {
  flex: 0 0 390px;
  background: rgba(255,255,255,.8);
  border: 1px solid rgba(85,49,215,.15);
  border-radius: 28px;
  overflow: hidden;
  scroll-snap-align: start;
  box-shadow: 0 18px 55px rgba(38, 26, 75, .08);
  transition: transform .3s ease, box-shadow .3s ease;
}

#combos-{{ section.id }} .purelane-combo:hover {
  transform: translateY(-6px);
  box-shadow: 0 25px 70px rgba(38, 26, 75, .13);
}

#combos-{{ section.id }} .purelane-combo__top {
  position: relative;
  min-height: 300px;
  padding: 25px;
  background: linear-gradient(
    145deg,
    #f8faf7,
    #e9f2e9
  );
}

#combos-{{ section.id }} .purelane-combo__badge,
#combos-{{ section.id }} .purelane-combo__save {
  position: absolute;
  top: 20px;
  z-index: 2;
  border-radius: 50px;
  padding: 8px 13px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
}

#combos-{{ section.id }} .purelane-combo__badge {
  left: 20px;
  color: #fff;
  background: #5531d7;
}

#combos-{{ section.id }} .purelane-combo__save {
  right: 20px;
  color: #426d31;
  background: #fff;
}

#combos-{{ section.id }} .purelane-combo__products {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 250px;
  padding-top: 20px;
}

#combos-{{ section.id }} .purelane-combo__product {
  width: 100px;
  text-align: center;
}

#combos-{{ section.id }} .purelane-combo__image {
  height: 145px;
  display: flex;
  align-items: center;
  justify-content: center;
}

#combos-{{ section.id }} .purelane-combo__image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

#combos-{{ section.id }} .purelane-combo__product span {
  display: block;
  margin-top: 6px;
  color: #333;
  font-size: 10px;
  line-height: 1.35;
}

#combos-{{ section.id }} .purelane-combo__plus {
  width: 30px;
  height: 30px;
  flex: 0 0 30px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: #5531d7;
  background: #fff;
  font-weight: 700;
  box-shadow: 0 5px 18px rgba(0,0,0,.07);
}

#combos-{{ section.id }} .purelane-combo__content {
  padding: 28px;
}

#combos-{{ section.id }} .purelane-combo__content h3 {
  margin: 0;
  color: #111;
  font-size: 25px;
  line-height: 1.1;
  letter-spacing: -.025em;
}

#combos-{{ section.id }} .purelane-combo__count {
  display: block;
  margin-top: 7px;
  color: #777;
  font-size: 12px;
}

#combos-{{ section.id }} .purelane-combo__content p {
  min-height: 65px;
  margin: 17px 0;
  color: #666;
  font-size: 13px;
  line-height: 1.6;
}

#combos-{{ section.id }} .purelane-combo__price {
  display: flex;
  align-items: center;
  gap: 10px;
}

#combos-{{ section.id }} .purelane-combo__price strong {
  color: #111;
  font-size: 25px;
}

#combos-{{ section.id }} .purelane-combo__price s {
  color: #999;
  font-size: 14px;
}

#combos-{{ section.id }} .purelane-combo__price em {
  color: #5531d7;
  font-size: 12px;
  font-style: normal;
  font-weight: 700;
}

#combos-{{ section.id }} .purelane-combo__fine {
  margin-top: 8px;
  color: #999;
  font-size: 10px;
}

#combos-{{ section.id }} .purelane-combo__button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  width: 100%;
  margin-top: 20px;
  padding: 15px 20px;
  border: 1px solid #5531d7;
  border-radius: 50px;
  color: #5531d7;
  background: #fff;
  text-decoration: none;
  font-size: 12px;
  font-weight: 700;
  transition: all .25s ease;
}

#combos-{{ section.id }} .purelane-combo__button:hover {
  color: #fff;
  background: #5531d7;
}

#combos-{{ section.id }} .purelane-combo__button span {
  font-size: 17px;
}

#combos-{{ section.id }} .purelane-combos__swipe {
  margin-top: 8px;
  text-align: center;
  color: #777;
  font-size: 11px;
  letter-spacing: .08em;
}

@media (max-width: 700px) {

  #combos-{{ section.id }} {
    padding: 75px 0;
  }

  #combos-{{ section.id }} .purelane-combos__container {
    width: calc(100% - 28px);
  }

  #combos-{{ section.id }} .purelane-combo {
    flex-basis: 310px;
  }

  #combos-{{ section.id }} .purelane-combo__top {
    min-height: 260px;
  }

  #combos-{{ section.id }} .purelane-combo__products {
    min-height: 215px;
  }

  #combos-{{ section.id }} .purelane-combo__product {
    width: 80px;
  }

  #combos-{{ section.id }} .purelane-combo__image {
    height: 115px;
  }

}

</style>



<section
  id="PurelaneBenefits-{{ section.id }}"
  class="purelane-benefits"
>
  <div class="purelane-benefits__container">

    {% if section.settings.eyebrow != blank %}
      <p class="purelane-benefits__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="purelane-benefits__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="purelane-benefits__description">
        {{ section.settings.description }}
      </div>
    {% endif %}


    <div class="purelane-benefits__grid">

      {% for block in section.blocks %}

        <div
          class="purelane-benefit"
          {{ block.shopify_attributes }}
        >

          <div class="purelane-benefit__icon">
            {% case block.settings.icon %}

              {% when 'leaf' %}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20 4C11 4 5 8 5 15c0 2 1 4 3 5 7-1 11-7 12-16Z"/>
                  <path d="M4 21c3-5 7-8 13-11"/>
                </svg>

              {% when 'shield' %}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 3 20 6v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-3Z"/>
                  <path d="m8.5 12 2.2 2.2 4.8-5"/>
                </svg>

              {% when 'sparkle' %}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m12 2 1.5 6.5L20 10l-6.5 1.5L12 18l-1.5-6.5L4 10l6.5-1.5L12 2Z"/>
                  <path d="m19 16 .7 2.3L22 19l-2.3.7L19 22l-.7-2.3L16 19l2.3-.7L19 16Z"/>
                </svg>

              {% when 'recycle' %}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m8 5 2-3 3 1-2 3"/>
                  <path d="M10 3 6 10h5"/>
                  <path d="m17 8 4 1-1 3-4-1"/>
                  <path d="m20 9-8 1 3 4"/>
                  <path d="m8 17-1 4-3-1 1-4"/>
                  <path d="m7 21 4-7-6 1"/>
                </svg>

              {% else %}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="8"/>
                </svg>

            {% endcase %}
          </div>


          {% if block.settings.title != blank %}
            <h3 class="purelane-benefit__title">
              {{ block.settings.title }}
            </h3>
          {% endif %}


          {% if block.settings.text != blank %}
            <div class="purelane-benefit__text">
              {{ block.settings.text }}
            </div>
          {% endif %}

        </div>

      {% endfor %}

    </div>

  </div>
</section>


<style>

#PurelaneBenefits-{{ section.id }} {

  --benefits-bg: {{ section.settings.background_color }};
  --benefits-text: {{ section.settings.text_color }};
  --benefits-accent: {{ section.settings.accent_color }};

  background: var(--benefits-bg);

  color: var(--benefits-text);

}


#PurelaneBenefits-{{ section.id }}
.purelane-benefits__container {

  max-width: 1350px;

  margin: 0 auto;

  padding:
    95px 40px
    100px;

}


/* HEADER */

#PurelaneBenefits-{{ section.id }}
.purelane-benefits__eyebrow {

  margin: 0 0 15px;

  text-align: center;

  font-size: 12px;

  font-weight: 800;

  letter-spacing: .18em;

  text-transform: uppercase;

  color: var(--benefits-accent);

}


#PurelaneBenefits-{{ section.id }}
.purelane-benefits__heading {

  max-width: 700px;

  margin:
    0 auto;

  text-align: center;

  font-size:
    clamp(3rem, 5vw, 5rem);

  line-height: .95;

  letter-spacing: -.055em;

  font-weight: 800;

}


#PurelaneBenefits-{{ section.id }}
.purelane-benefits__description {

  max-width: 600px;

  margin:
    22px auto 0;

  text-align: center;

  font-size: 17px;

  line-height: 1.6;

  opacity: .7;

}


/* GRID */

#PurelaneBenefits-{{ section.id }}
.purelane-benefits__grid {

  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  margin-top: 65px;

  border-top:
    1px solid rgba(0,0,0,.1);

  border-bottom:
    1px solid rgba(0,0,0,.1);

}


/* CARD */

#PurelaneBenefits-{{ section.id }}
.purelane-benefit {

  position: relative;

  padding:
    42px 30px
    45px;

  text-align: center;

  transition:
    transform .25s ease,
    background .25s ease;

}


#PurelaneBenefits-{{ section.id }}
.purelane-benefit + .purelane-benefit {

  border-left:
    1px solid rgba(0,0,0,.1);

}


#PurelaneBenefits-{{ section.id }}
.purelane-benefit:hover {

  transform: translateY(-5px);

  background:
    rgba(255,255,255,.5);

}


/* ICON */

#PurelaneBenefits-{{ section.id }}
.purelane-benefit__icon {

  width: 58px;

  height: 58px;

  margin: 0 auto 22px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background:
    rgba(90,59,181,.08);

  color: var(--benefits-accent);

}


#PurelaneBenefits-{{ section.id }}
.purelane-benefit__icon svg {

  width: 27px;

  height: 27px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.6;

  stroke-linecap: round;

  stroke-linejoin: round;

}


/* TITLE */

#PurelaneBenefits-{{ section.id }}
.purelane-benefit__title {

  margin: 0;

  font-size: 17px;

  line-height: 1.3;

  font-weight: 800;

}


/* TEXT */

#PurelaneBenefits-{{ section.id }}
.purelane-benefit__text {

  margin-top: 12px;

  font-size: 14px;

  line-height: 1.6;

  opacity: .68;

}


/* MOBILE */

@media screen and (max-width: 989px) {

  #PurelaneBenefits-{{ section.id }}
  .purelane-benefits__grid {

    grid-template-columns:
      repeat(2, 1fr);

  }

  #PurelaneBenefits-{{ section.id }}
  .purelane-benefit:nth-child(3) {

    border-left: 0;

    border-top:
      1px solid rgba(0,0,0,.1);

  }

  #PurelaneBenefits-{{ section.id }}
  .purelane-benefit:nth-child(4) {

    border-top:
      1px solid rgba(0,0,0,.1);

  }

}


@media screen and (max-width: 600px) {

  #PurelaneBenefits-{{ section.id }}
  .purelane-benefits__container {

    padding:
      65px 20px
      70px;

  }

  #PurelaneBenefits-{{ section.id }}
  .purelane-benefits__grid {

    grid-template-columns: 1fr;

  }

  #PurelaneBenefits-{{ section.id }}
  .purelane-benefit {

    padding: 35px 20px;

  }

  #PurelaneBenefits-{{ section.id }}
  .purelane-benefit + .purelane-benefit {

    border-left: 0;

    border-top:
      1px solid rgba(0,0,0,.1);

  }

}

</style>


{% schema %}

{
  "name": "Purelane benefits",

  "tag": "section",

  "class": "section-purelane-benefits",

  "settings": [

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHY PURELANE"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Better for your home. Better by design."
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Thoughtfully made essentials that make everyday cleaning simpler, safer and more intentional.</p>"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#17122D"
    },

    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#5A3BB5"
    }

  ],

  "blocks": [

    {
      "type": "benefit",

      "name": "Benefit",

      "settings": [

        {
          "type": "select",
          "id": "icon",
          "label": "Icon",

          "options": [
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            },
            {
              "value": "recycle",
              "label": "Recycle"
            }
          ],

          "default": "leaf"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Plant powered"
        },

        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Thoughtfully selected ingredients designed for everyday use.</p>"
        }

      ]

    }

  ],

  "presets": [

    {
      "name": "Purelane benefits",

      "blocks": [

        {
          "type": "benefit",
          "settings": {
            "icon": "leaf",
            "title": "Plant powered",
            "text": "<p>Thoughtfully selected ingredients designed for everyday use.</p>"
          }
        },

        {
          "type": "benefit",
          "settings": {
            "icon": "shield",
            "title": "Family friendly",
            "text": "<p>Made with your home, family and everyday routines in mind.</p>"
          }
        },

        {
          "type": "benefit",
          "settings": {
            "icon": "sparkle",
            "title": "Powerful cleaning",
            "text": "<p>Effective formulas built to tackle the mess that everyday life brings.</p>"
          }
        },

        {
          "type": "benefit",
          "settings": {
            "icon": "recycle",
            "title": "Less waste",
            "text": "<p>Thoughtful packaging and refill-minded choices wherever possible.</p>"
          }
        }

      ]

    }

  ]

}

{% endschema %}
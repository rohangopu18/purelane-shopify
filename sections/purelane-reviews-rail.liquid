<style>

.purelane-reviews {
  width: 100%;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(255,255,255,0.55),
      transparent 45%
    ),
    linear-gradient(
      180deg,
      #dff6e8 0%,
      #cdebdc 100%
    );

  padding: 72px 0 78px;
  position: relative;
}


/* HEADER */

.purelane-reviews-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28px;
  flex-wrap: wrap;

  padding: 0 30px 42px;

  font-family: Arial, Helvetica, sans-serif;

  color: #253128;
  letter-spacing: 2px;
  font-size: 14px;
  font-weight: 700;
}

.purelane-reviews-eyebrow {
  color: #718176;
}

.purelane-rating {
  display: flex;
  align-items: center;
  gap: 8px;
}

.purelane-rating .stars {
  color: #6c9b18;
  letter-spacing: 2px;
  font-size: 16px;
}

.purelane-rating strong {
  color: #c57912;
  font-size: 19px;
}

.purelane-loved strong {
  color: #c57912;
}


/* MOVING WINDOW */

.purelane-reviews-window {
  width: 100%;
  overflow: hidden;
  position: relative;
}


/* MOVING TRACK */

.purelane-reviews-track {
  display: flex;
  width: max-content;

  animation: purelaneReviewsMove 65s linear infinite;

  will-change: transform;
}


/* PAUSE WHEN MOUSE IS OVER IT */

.purelane-reviews-window:hover .purelane-reviews-track {
  animation-play-state: paused;
}


/* REVIEW CARD */

.purelane-review {
  width: 355px;
  min-height: 205px;

  margin-right: 16px;
  padding: 25px 24px 23px;

  border-radius: 22px;

  background: rgba(255,255,255,0.66);

  border: 1px solid rgba(255,255,255,0.85);

  box-shadow:
    0 8px 30px rgba(54, 101, 76, 0.08),
    inset 0 1px 0 rgba(255,255,255,0.8);

  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);

  flex-shrink: 0;

  font-family: Arial, Helvetica, sans-serif;

  box-sizing: border-box;
}


/* STARS */

.review-stars {
  color: #6c9b18;
  letter-spacing: 3px;
  font-size: 14px;
  margin-bottom: 15px;
}


/* TITLE */

.purelane-review h3 {
  margin: 0 0 12px;

  color: #22242b;

  font-size: 16px;
  line-height: 1.2;

  letter-spacing: 0.6px;
  font-weight: 800;
}


/* REVIEW */

.purelane-review p {
  margin: 0;

  color: #626c67;

  font-size: 14px;
  line-height: 1.55;

  letter-spacing: 0.1px;
}


/* AUTHOR */

.review-author {
  margin-top: 18px;

  color: #1e5d45;

  font-size: 12px;
  font-weight: 800;

  letter-spacing: 1.5px;
}

.review-author span {
  color: #548e16;
  margin-right: 5px;
}

.review-author small {
  color: #738078;
  font-size: 10px;
  letter-spacing: 1px;
}


/* INFINITE MOVEMENT */

@keyframes purelaneReviewsMove {

  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }

}


/* DESKTOP */

@media screen and (min-width: 1200px) {

  .purelane-review {
    width: 355px;
  }

}


/* TABLET */

@media screen and (max-width: 900px) {

  .purelane-reviews {
    padding: 55px 0 60px;
  }

  .purelane-reviews-header {
    gap: 15px;
    padding-bottom: 30px;

    font-size: 11px;
  }

  .purelane-review {
    width: 315px;
    min-height: 205px;
  }

}


/* MOBILE */

@media screen and (max-width: 600px) {

  .purelane-reviews {
    padding: 48px 0 52px;
  }

  .purelane-reviews-header {
    flex-direction: column;
    gap: 9px;

    padding: 0 20px 28px;

    text-align: center;

    font-size: 10px;
    letter-spacing: 1.4px;
  }

  .purelane-rating .stars {
    font-size: 13px;
  }

  .purelane-rating strong {
    font-size: 16px;
  }

  .purelane-review {
    width: 285px;
    min-height: 200px;

    padding: 21px;

    border-radius: 18px;
  }

  .purelane-review h3 {
    font-size: 14px;
  }

  .purelane-review p {
    font-size: 13px;
  }

  .review-author {
    font-size: 10px;
  }

}


/* ACCESSIBILITY */

@media (prefers-reduced-motion: reduce) {

  .purelane-reviews-track {
    animation: none;
  }

}

</style>



<section id="bundles-{{ section.id }}" class="pl-bundles">

  <div class="pl-bundles__container">

    <div class="pl-bundles__header">
      <span>{{ section.settings.eyebrow }}</span>

      <h2>{{ section.settings.heading }}</h2>

      <p>{{ section.settings.description }}</p>
    </div>

    <div class="pl-bundles__grid">

      {% for block in section.blocks %}

        <article
          class="pl-bundle {% if block.settings.featured %}pl-bundle--featured{% endif %}"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.badge != blank %}
            <div class="pl-bundle__badge">
              {{ block.settings.badge }}
            </div>
          {% endif %}

          <div class="pl-bundle__visual">

            {% for i in (1..5) %}

              {% case i %}
                {% when 1 %}
                  {% assign product = block.settings.product_1 %}
                {% when 2 %}
                  {% assign product = block.settings.product_2 %}
                {% when 3 %}
                  {% assign product = block.settings.product_3 %}
                {% when 4 %}
                  {% assign product = block.settings.product_4 %}
                {% when 5 %}
                  {% assign product = block.settings.product_5 %}
              {% endcase %}

              {% if product != blank %}
                <div class="pl-bundle__product">

                  {% if product.featured_image %}
                    {{
                      product.featured_image
                      | image_url: width: 300
                      | image_tag:
                        loading: 'lazy',
                        alt: product.title
                    }}
                  {% endif %}

                </div>
              {% endif %}

            {% endfor %}

          </div>

          <div class="pl-bundle__content">

            <h3>{{ block.settings.title }}</h3>

            <div class="pl-bundle__quantity">
              {{ block.settings.quantity }}
              <span>Products</span>
            </div>

            <div class="pl-bundle__price">

              <strong>
                {{ block.settings.price }}
              </strong>

              {% if block.settings.compare_price != blank %}
                <s>
                  {{ block.settings.compare_price }}
                </s>
              {% endif %}

            </div>

            <p class="pl-bundle__per">
              {{ block.settings.per_product }}
            </p>

            <ul>

              {% if block.settings.point_1 != blank %}
                <li>✓ {{ block.settings.point_1 }}</li>
              {% endif %}

              {% if block.settings.point_2 != blank %}
                <li>✓ {{ block.settings.point_2 }}</li>
              {% endif %}

              {% if block.settings.point_3 != blank %}
                <li>✓ {{ block.settings.point_3 }}</li>
              {% endif %}

            </ul>

            <a
              href="{{ block.settings.button_link | default: '#shop' }}"
              class="pl-bundle__button {% if block.settings.featured %}pl-bundle__button--primary{% endif %}"
            >
              {{ block.settings.button_text }}
              <span>→</span>
            </a>

          </div>

        </article>

      {% endfor %}

    </div>

  </div>

</section>


<style>

#bundles-{{ section.id }} {
  padding: 110px 0;
  background: #f7f4ed;
}

#bundles-{{ section.id }} .pl-bundles__container {
  width: min(1250px, calc(100% - 40px));
  margin: auto;
}

#bundles-{{ section.id }} .pl-bundles__header {
  text-align: center;
  max-width: 760px;
  margin: 0 auto 55px;
}

#bundles-{{ section.id }} .pl-bundles__header > span {
  color: #5531d7;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .18em;
  text-transform: uppercase;
}

#bundles-{{ section.id }} .pl-bundles__header h2 {
  margin: 14px 0 18px;
  color: #111;
  font-size: clamp(40px, 5vw, 64px);
  line-height: 1;
  letter-spacing: -.05em;
}

#bundles-{{ section.id }} .pl-bundles__header p {
  max-width: 650px;
  margin: auto;
  color: #69657a;
  font-size: 16px;
  line-height: 1.7;
}

#bundles-{{ section.id }} .pl-bundles__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  align-items: stretch;
}

#bundles-{{ section.id }} .pl-bundle {
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(85,49,215,.14);
  border-radius: 28px;
  background: rgba(255,255,255,.82);
  box-shadow: 0 15px 45px rgba(35,25,70,.07);
  transition: transform .3s ease, box-shadow .3s ease;
}

#bundles-{{ section.id }} .pl-bundle:hover {
  transform: translateY(-7px);
  box-shadow: 0 25px 65px rgba(35,25,70,.13);
}

#bundles-{{ section.id }} .pl-bundle--featured {
  border: 2px solid #5531d7;
  transform: translateY(-10px);
}

#bundles-{{ section.id }} .pl-bundle--featured:hover {
  transform: translateY(-16px);
}

#bundles-{{ section.id }} .pl-bundle__badge {
  position: absolute;
  top: 18px;
  left: 18px;
  z-index: 3;
  padding: 8px 13px;
  border-radius: 50px;
  color: #fff;
  background: #5531d7;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
}

#bundles-{{ section.id }} .pl-bundle__visual {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 260px;
  padding: 55px 25px 25px;
  background: linear-gradient(
    145deg,
    #f8faf7,
    #e5f0e7
  );
}

#bundles-{{ section.id }} .pl-bundle__product {
  width: 105px;
  height: 175px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -18px;
  transition: transform .3s ease;
}

#bundles-{{ section.id }} .pl-bundle__product:first-child {
  margin-left: 0;
}

#bundles-{{ section.id }} .pl-bundle:hover .pl-bundle__product:nth-child(1) {
  transform: rotate(-5deg) translateY(-5px);
}

#bundles-{{ section.id }} .pl-bundle:hover .pl-bundle__product:nth-child(2) {
  transform: translateY(-10px);
}

#bundles-{{ section.id }} .pl-bundle:hover .pl-bundle__product:nth-child(3) {
  transform: rotate(5deg) translateY(-5px);
}

#bundles-{{ section.id }} .pl-bundle__product img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

#bundles-{{ section.id }} .pl-bundle__content {
  padding: 30px;
}

#bundles-{{ section.id }} .pl-bundle__content h3 {
  margin: 0 0 8px;
  color: #111;
  font-size: 27px;
  line-height: 1.1;
  letter-spacing: -.03em;
}

#bundles-{{ section.id }} .pl-bundle__quantity {
  color: #777;
  font-size: 12px;
}

#bundles-{{ section.id }} .pl-bundle__quantity span {
  display: inline-block;
  margin-left: 3px;
  color: #777;
}

#bundles-{{ section.id }} .pl-bundle__price {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 18px;
}

#bundles-{{ section.id }} .pl-bundle__price strong {
  color: #111;
  font-size: 30px;
}

#bundles-{{ section.id }} .pl-bundle__price s {
  color: #999;
  font-size: 14px;
}

#bundles-{{ section.id }} .pl-bundle__per {
  margin: 5px 0 20px;
  color: #5531d7;
  font-size: 12px;
  font-weight: 600;
}

#bundles-{{ section.id }} .pl-bundle ul {
  display: grid;
  gap: 11px;
  min-height: 105px;
  margin: 0;
  padding: 0;
  list-style: none;
}

#bundles-{{ section.id }} .pl-bundle li {
  color: #555;
  font-size: 13px;
  line-height: 1.4;
}

#bundles-{{ section.id }} .pl-bundle__button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  width: 100%;
  margin-top: 20px;
  padding: 16px 20px;
  border: 1px solid #5531d7;
  border-radius: 50px;
  color: #5531d7;
  background: #fff;
  text-decoration: none;
  font-size: 12px;
  font-weight: 700;
  transition: .25s ease;
}

#bundles-{{ section.id }} .pl-bundle__button:hover {
  color: #fff;
  background: #5531d7;
}

#bundles-{{ section.id }} .pl-bundle__button--primary {
  color: #fff;
  background: #5531d7;
}

#bundles-{{ section.id }} .pl-bundle__button--primary:hover {
  background: #4222ae;
}

#bundles-{{ section.id }} .pl-bundle__button span {
  font-size: 17px;
}


@media (max-width: 900px) {

  #bundles-{{ section.id }} .pl-bundles__grid {
    grid-template-columns: 1fr;
    max-width: 520px;
    margin: auto;
  }

  #bundles-{{ section.id }} .pl-bundle--featured {
    transform: none;
  }

  #bundles-{{ section.id }} .pl-bundle--featured:hover {
    transform: translateY(-7px);
  }

}


@media (max-width: 550px) {

  #bundles-{{ section.id }} {
    padding: 75px 0;
  }

  #bundles-{{ section.id }} .pl-bundles__container {
    width: calc(100% - 28px);
  }

  #bundles-{{ section.id }} .pl-bundle__visual {
    min-height: 230px;
  }

}

</style>


{% schema %}
{

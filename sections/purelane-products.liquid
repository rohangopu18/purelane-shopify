<section
  class="purelane-products"
  id="PurelaneProducts-{{ section.id }}"
>
  <div class="purelane-products__inner page-width">

    <div class="purelane-products__header">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="purelane-products__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="purelane-products__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
      </div>

      {% if section.settings.view_all_text != blank %}
        <a
          href="{{ section.settings.view_all_link | default: routes.all_products_collection_url }}"
          class="purelane-products__view-all"
        >
          {{ section.settings.view_all_text | escape }}
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>

    {% if section.settings.collection != blank %}
      {% assign collection = section.settings.collection %}

      <div class="purelane-products__grid">

        {% for product in collection.products limit: section.settings.products_to_show %}

          <article class="purelane-product-card">

            <a
              href="{{ product.url }}"
              class="purelane-product-card__image-link"
            >
              <div class="purelane-product-card__image-wrapper">

                {% if product.featured_image != blank %}
                  {{
                    product.featured_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '360, 540, 720, 900',
                      sizes: '(min-width: 990px) 25vw, 50vw',
                      class: 'purelane-product-card__image',
                      alt: product.featured_image.alt | default: product.title
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'purelane-product-card__placeholder' }}
                {% endif %}

                {% if product.compare_at_price > product.price %}
                  <span class="purelane-product-card__badge">
                    Sale
                  </span>
                {% endif %}

              </div>
            </a>

            <div class="purelane-product-card__content">

              <h3 class="purelane-product-card__title">
                <a href="{{ product.url }}">
                  {{ product.title | escape }}
                </a>
              </h3>

              <div class="purelane-product-card__price">

                {% if product.price_varies %}
                  <span>
                    From {{ product.price_min | money }}
                  </span>
                {% else %}
                  <span>
                    {{ product.price | money }}
                  </span>
                {% endif %}

                {% if product.compare_at_price > product.price %}
                  <s>
                    {{ product.compare_at_price | money }}
                  </s>
                {% endif %}

              </div>

              {% if product.available %}
                <span class="purelane-product-card__availability">
                  Available
                </span>
              {% else %}
                <span class="purelane-product-card__availability purelane-product-card__availability--sold-out">
                  Sold out
                </span>
              {% endif %}

            </div>

          </article>

        {% endfor %}

      </div>

      {% if collection.products.size == 0 %}
        <div class="purelane-products__empty">
          <p>No products available yet.</p>
        </div>
      {% endif %}

    {% else %}

      <div class="purelane-products__empty">
        <p>Select a collection from the theme editor.</p>
      </div>

    {% endif %}

  </div>
</section>

<style>
  #PurelaneProducts-{{ section.id }} {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  #PurelaneProducts-{{ section.id }} .purelane-products__inner {
    padding-top: 7rem;
    padding-bottom: 7rem;
  }

  #PurelaneProducts-{{ section.id }} .purelane-products__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  #PurelaneProducts-{{ section.id }} .purelane-products__eyebrow {
    margin: 0 0 1rem;
    color: {{ section.settings.accent_color }};
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  #PurelaneProducts-{{ section.id }} .purelane-products__heading {
    margin: 0;
    font-size: clamp(3rem, 4vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  #PurelaneProducts-{{ section.id }} .purelane-products__view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid currentColor;
    color: {{ section.settings.text_color }};
    font-size: 1.4rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 180ms ease;
  }

  #PurelaneProducts-{{ section.id }} .purelane-products__view-all:hover {
    opacity: 0.65;
  }

  #PurelaneProducts-{{ section.id }} .purelane-products__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.4rem;
  }

  #PurelaneProducts-{{ section.id }} .purelane-product-card {
    min-width: 0;
  }

  #PurelaneProducts-{{ section.id }} .purelane-product-card__image-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #PurelaneProducts-{{ section.id }} .purelane-product-card__image-wrapper {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 1.6rem;
    background: #f4f2ef;
  }

  #PurelaneProducts-{{ section.id }} .purelane-product-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms ease;
  }

  #PurelaneProducts-{{ section.id }} .purelane-product-card:hover
  .purelane-product-card__image {
    transform: scale(1.04);
  }

  #PurelaneProducts-{{ section.id }} .purelane-product-card__placeholder {
    width: 60%;
    height: 60%;
    margin: 20%;
    opacity: 0.3;
  }

  #PurelaneProducts-{{ section.id }} .purelane-product-card__badge {
    position: absolute;
    top: 1.2rem;
    left: 1.2rem;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    background: {{ section.settings.accent_color }};
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 700;
  }

  #PurelaneProducts-{{ section.id }} .purelane-product-card__content {
    padding-top: 1.5rem;
  }

  #PurelaneProducts-{{ section.id }} .purelane-product-card__title {
    margin: 0;
    font-size: 1.6rem;
    line-height: 1.3;
    font-weight: 600;
  }

  #PurelaneProducts-{{ section.id }} .purelane-product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  #PurelaneProducts-{{ section.id }} .purelane-product-card__price {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 0.7rem;
    font-size: 1.4rem;
    font-weight: 600;
  }

  #PurelaneProducts-{{ section.id }} .purelane-product-card__price s {
    opacity: 0.5;
    font-weight: 400;
  }

  #PurelaneProducts-{{ section.id }} .purelane-product-card__availability {
    display: block;
    margin-top: 0.6rem;
    color: #47704f;
    font-size: 1.1rem;
    font-weight: 600;
  }

  #PurelaneProducts-{{ section.id }}
  .purelane-product-card__availability--sold-out {
    color: #9a4b4b;
  }

  #PurelaneProducts-{{ section.id }} .purelane-products__empty {
    padding: 5rem 2rem;
    border: 1px dashed rgba(0, 0, 0, 0.18);
    border-radius: 1.6rem;
    text-align: center;
    opacity: 0.7;
  }

  @media screen and (max-width: 989px) {
    #PurelaneProducts-{{ section.id }} .purelane-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }

    #PurelaneProducts-{{ section.id }} .purelane-products__inner {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
  }

  @media screen and (max-width: 749px) {
    #PurelaneProducts-{{ section.id }} .purelane-products__header {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.8rem;
      margin-bottom: 3rem;
    }

    #PurelaneProducts-{{ section.id }} .purelane-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.2rem;
    }

    #PurelaneProducts-{{ section.id }} .purelane-product-card__image-wrapper {
      border-radius: 1rem;
    }

    #PurelaneProducts-{{ section.id }} .purelane-product-card__content {
      padding-top: 1rem;
    }

    #PurelaneProducts-{{ section.id }} .purelane-product-card__title {
      font-size: 1.35rem;
    }

    #PurelaneProducts-{{ section.id }} .purelane-product-card__price {
      font-size: 1.25rem;
    }
  }
</style>

{% schema %}
{
  "name": "Purelane products",
  "tag": "section",
  "class": "section-purelane-products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SHOP PURELANE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clean essentials for everyday living."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#5B3CC4"
    }
  ],
  "presets": [
    {
      "name": "Purelane products"
    }
  ]
}
{% endschema %}
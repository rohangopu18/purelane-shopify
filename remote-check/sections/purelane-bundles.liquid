          "label": "Product 3"
        },

        {
          "type": "product",
          "id": "product_4",
          "label": "Product 4"
        },

        {
          "type": "product",
          "id": "product_5",
          "label": "Product 5"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Starter"
        },

        {
          "type": "text",
          "id": "quantity",
